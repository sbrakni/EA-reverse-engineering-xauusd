; Quantum Queen X reconstruction - CONSERVATIVE preset
;
; Sizing is solved from the grid's own geometry (QQX_MM_GRID_BUDGET), so the
; lot can never exceed what a fully deployed ladder can survive.  On a 10,000
; account at gold ~4400 this yields about 0.01 lots for 9 slots x 6 levels.
;
; Both blown backtests were configuration failures, not strategy failures:
;   run 1: InpEquityStopPercent=60 liquidated 4 baskets that still had
;          202-336% margin level, for -19,802.
;   run 2: 0.02 lots/1000 on 9 slots x 12 levels sized entries at ~0.22 lots,
;          roughly 22x what the account could carry.  One 3-leg basket lost
;          -12,128 and the account was gone in 10 days.
InpPreset=1
InpMagicBase=22345000
InpTradeSymbol=
InpSlippagePoints=30
InpMaxSpreadPoints=60
InpComment=QQX
InpMMMode=3
InpFixedLot=0.01
InpLotsPer1000=0.005
InpMaxBasketDDPercent=15.0
InpMaxMarginPercent=20.0
InpMaxLot=10.0
InpGridLotMultiplier=1.0
InpTpScale=1
InpStepScale=1
InpTpAtrMult=0.35
InpStepAtrMult=0.6
InpTpFixedPoints=100
InpStepFixedPoints=200
InpAtrPeriod=14
InpGridTimeframe=1
InpMinSecondsBetween=60
InpMaxGridLevels=6
InpUseProfitTrail=false
InpTrailStartMult=1.0
InpTrailGiveback=0.3
InpBasketStopMult=0.0
InpMaxBasketMinutes=0
InpCloseOnFriday=false
InpFridayCloseHour=22
InpUseTrendFilter=true
InpUseRsiFilter=true
InpUsePullbackFilter=true
InpEmaFastPeriod=21
InpEmaSlowPeriod=89
InpRsiPeriod=14
InpRsiBuyMax=52.0
InpRsiSellMin=48.0
InpExtremeLookback=24
InpPullbackAtr=0.5
InpGridStepMult=1.50
InpGridTrendGuard=false
InpGuardTimeframe=16385
InpGuardPeriod=50
InpGuardSlopeAtr=0.12
InpVolRegimeGate=true
InpMaxAtrRatio=2.2
InpRecoveryLevel=5
InpRecoveryHours=4.0
InpRecoveryTargetMult=0.35
InpBreakEvenHours=24.0
InpGiveUpHours=0.0
InpGiveUpLossPct=1.0
InpPairDeRisk=true
InpMinMarginLevel=400.0
InpAddMarginFloor=150.0
InpBasketMaxLossPct=0.0
InpMaxTotalPositions=40
InpMaxLotsPerSide=0.0
InpSoftBrakePercent=70.0
InpEquityStopPercent=0.0
InpDailyLossStop=0.0
InpShowPanel=true
