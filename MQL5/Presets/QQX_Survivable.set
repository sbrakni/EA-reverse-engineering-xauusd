; Quantum Queen X reconstruction - SURVIVABLE preset
;
; Derived from the 2026.01.01-2026.08.11 backtest of the LowRisk preset, which
; ended at -11,776 on a 10,000 account.  445 baskets, 440 of them profitable.
; All of the damage came from two settings, not from the strategy:
;
;   * InpEquityStopPercent=60 liquidated 4 baskets that still had 202-336%
;     margin level, for -19,802.  37 of the 42 baskets that dipped that deep
;     recovered on their own.
;   * 0.0100 lots per 1000 was too large for the drawdown the grid needs to
;     survive: one basket ran a floating loss of 137% of balance and was
;     margin-called at -53% margin level, for -11,738.
;
; This preset halves the size, replaces liquidation with a soft brake plus a
; margin-level guard, and widens the grid geometrically.
InpPreset=1
InpMagicBase=22345000
InpTradeSymbol=
InpSlippagePoints=30
InpMaxSpreadPoints=60
InpComment=QQX
; --- sizing: 0.0050/1000 survives every 2026 drawdown (worst margin level 73%)
;     use 0.0035 for real headroom (181%)
InpMMMode=1
InpFixedLot=0.01
InpLotsPer1000=0.0035
InpMaxLot=10.0
InpGridLotMultiplier=1.0
InpTpScale=1
InpStepScale=1
InpTpAtrMult=0.35
InpStepAtrMult=0.6
InpTpFixedPoints=100
InpStepFixedPoints=200
InpAtrPeriod=14
InpGridTimeframe=1
InpMinSecondsBetween=60
InpMaxGridLevels=8
InpUseProfitTrail=false
InpTrailStartMult=1.0
InpTrailGiveback=0.3
InpBasketStopMult=0.0
InpMaxBasketMinutes=0
InpCloseOnFriday=false
InpFridayCloseHour=22
InpUseTrendFilter=true
InpUseRsiFilter=true
InpUsePullbackFilter=true
InpEmaFastPeriod=21
InpEmaSlowPeriod=89
InpRsiPeriod=14
InpRsiBuyMax=52.0
InpRsiSellMin=48.0
InpExtremeLookback=24
InpPullbackAtr=0.5
; --- grid safety: x1.35 spacing turns 8 levels of ~16 USD coverage into ~48 USD
InpGridStepMult=1.35
InpGridTrendGuard=true
InpGuardTimeframe=16385
InpGuardPeriod=50
InpGuardSlopeAtr=0.12
InpVolRegimeGate=true
InpMaxAtrRatio=2.2
; --- recovery: relax the target on aged baskets, never force a loss
InpRecoveryLevel=5
InpRecoveryHours=4.0
InpRecoveryTargetMult=0.35
InpBreakEvenHours=24.0
InpGiveUpHours=0.0
InpGiveUpLossPct=1.0
InpPairDeRisk=true
; --- protection: margin guard instead of liquidation
InpMinMarginLevel=400.0
InpBasketMaxLossPct=0.0
InpMaxTotalPositions=40
InpMaxLotsPerSide=0.0
InpSoftBrakePercent=70.0
InpEquityStopPercent=0.0
InpDailyLossStop=0.0
InpShowPanel=true
